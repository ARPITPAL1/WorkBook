# Real Estate Construction Management System - Environment Example
DJANGO_SECRET_KEY=change-this-to-a-secure-random-key-in-production
DEBUG=False
ALLOWED_HOSTS=construction.example.com,localhost,127.0.0.1

# Database Configuration (PostgreSQL)
USE_SQLITE=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=construction_db
DB_USER=construction_user
DB_PASSWORD=strong_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Private Storage
PRIVATE_MEDIA_ROOT=/var/construction/private_media/
